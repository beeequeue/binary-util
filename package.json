{
  "name": "binary-util",
  "description": "A utility library for working with binary data.",
  "type": "module",
  "version": "2.0.6",
  "author": "BeeeQueue <adam@haglund.dev>",
  "repository": {
    "type": "github",
    "url": "https://github.com/beeequeue/binary-util"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "simple-git-hooks": {
    "pre-commit": "upm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,json5,yaml,yml,css,scss,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "files": [
    "dist"
  ],
  "exports": {
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:format": "oxfmt --check",
    "test": "vitest",
    "lint-staged:setup": "node --run lint-staged:setup:1; node --run lint-staged:setup:2",
    "lint-staged:setup:1": "git config set hook.\"lint-staged\".event pre-commit",
    "lint-staged:setup:2": "git config set hook.\"lint-staged\".command \"node node_modules/lint-staged/bin/lint-staged.js\""
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@e18e/eslint-plugin": "0.8.1",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.23.5",
    "vitest": "5.1.0"
  }
}
